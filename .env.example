# Redis on the host laptop. With a password: redis://:PASSWORD@HOST_IP:6379/0
REDIS_URL=redis://localhost:6379/0
# Ollama on this laptop
OLLAMA_URL=http://localhost:11434
MODEL=gemma4:e4b
# Shown in reports; defaults to the computer name when empty
WORKER_NAME=
# Seconds to wait for one model reply; raise it on a slow laptop
MODEL_TIMEOUT_S=600

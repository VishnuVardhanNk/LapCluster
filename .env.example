# Host laptop:    redis://:PASSWORD@localhost:6379/0
# Other laptops:  redis://:PASSWORD@auto:6379/0   ("auto" finds the host by itself)
# Fixed address:  redis://:PASSWORD@HOST_IP:6379/0
REDIS_URL=redis://localhost:6379/0
# Only if several hosts answer on the same network: the name of the one to join
CLUSTER_HOST=
# Ollama on this laptop
OLLAMA_URL=http://localhost:11434
MODEL=gemma4:e4b
# Shown in reports; defaults to the computer name when empty
WORKER_NAME=
# Seconds to wait for one model reply; raise it on a slow laptop
MODEL_TIMEOUT_S=600
# Tokens the model may read and write per request; the host's value is used by the whole cluster
MODEL_CONTEXT=32768
# Largest piece of one file per task, in characters; longer files are split
PART_CHARS=48000
